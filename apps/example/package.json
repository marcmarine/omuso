{
	"name": "app-example",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.html",
		"build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"start": "bun ./dist/index.html"
	},
	"dependencies": {
		"@omuso/react-reader": "workspace:*",
		"omuso": "workspace:*",
		"react": "^19",
		"react-dom": "^19",
		"wouter": "^3.11.0"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
