{
	"name": "@omuso/react-reader",
	"version": "0.2.2",
	"description": "A markdown-reader for React powered by OMUSO.",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./styles.css": "./dist/index.css"
	},
	"types": "dist/index.d.ts",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcmarine/omuso.git",
		"directory": "packages/react-reader"
	},
	"bugs": "https://github.com/marcmarine/omuso/issues/new",
	"author": "Marc Mariné <shenobi@gmail.com>",
	"license": "MIT",
	"scripts": {
		"dev": "bun build ./src/index.ts --outdir ./dist --target browser --minify --packages external --watch",
		"build:types": "tsc --emitDeclarationOnly",
		"build": "bun build ./src/index.ts --outdir ./dist --target browser --minify --packages external && bun run build:types"
	},
	"dependencies": {
		"omuso": "^1.6.0"
	},
	"devDependencies": {
		"@types/react": "^19",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"peerDependencies": {
		"react": "^18 || ^19",
		"typescript": "^5"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"react",
		"reader",
		"markdown",
		"omuso"
	]
}
