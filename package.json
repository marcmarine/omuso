{
	"name": "omuso-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "Monorepo for omuso and related packages.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcmarine/omuso.git"
	},
	"license": "MIT",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "bun --filter omuso dev & bun --filter @omuso/react-reader dev & bun --filter app-example dev",
		"build": "bun --filter '*' build",
		"test": "bun --filter '*' test",
		"lint": "biome check packages/*/src",
		"lint:fix": "biome check --write packages/*/src"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"overrides": {
		"typescript": "^5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	}
}
