{
	"name": "omuso-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "Monorepo for omuso and related packages.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcmarine/omuso.git"
	},
	"license": "MIT",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun --filter '*' build",
		"test": "bun --filter '*' test",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.5",
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"overrides": {
		"typescript": "^5"
	}
}
